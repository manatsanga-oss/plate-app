@echo off
chcp 65001 >nul
REM สร้าง "คู่มือรายการอะไหล่" (สมุดภาพอะไหล่รายบล็อก) จากไฟล์ PL-*.PDF ของ Honda
REM ลากไฟล์ PDF วางบนไฟล์นี้ แล้วพิมพ์ slug (เช่น adv160) + ชื่อรุ่น (เช่น ADV160 ให้ตรงกับรุ่นในหน้าชุดสี)

setlocal
cd /d "%~dp0\.."

if "%~1"=="" (
  set /p PDFPATH="ลากไฟล์ PDF มาวาง หรือพิมพ์ path ของ PDF: "
) else (
  set "PDFPATH=%~1"
)
set /p SLUG="slug (ตัวพิมพ์เล็ก ไม่มีช่องว่าง เช่น adv160): "
set /p MODEL="ชื่อรุ่น ให้ตรงกับ dropdown รุ่น ในหน้าชุดสี (เช่น ADV160): "

echo.
python tools\build_parts_book.py "%PDFPATH%" %SLUG% %MODEL%

echo.
echo ============================================================
echo  ถ้าขึ้น "✔" = สำเร็จ (ใช้เวลา ~10 นาที/เล่ม เพราะย่อรูปทุกบล็อก)
echo  ขั้นต่อไป: บอก Claude ว่า "push" เพื่อขึ้นเว็บจริง
echo ============================================================
pause
